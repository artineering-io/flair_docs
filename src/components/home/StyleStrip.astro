---
// A grid of labelled style images.
interface Props {
	images: { src: string; label: string }[];
}
const { images } = Astro.props;
---

<div class="strip not-content">
	{
		images.map(({ src, label }) => (
			<figure>
				<img src={src} alt="" />
				<figcaption>{label}</figcaption>
			</figure>
		))
	}
</div>

<style>
	.strip {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin-top: 2.25rem;
	}
	figure {
		position: relative;
		margin: 0;
	}
	img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 1; /* the style headers are lettering; 3:1 keeps the word in frame */
		object-fit: cover;
		border-radius: 10px;
		border: 1px solid var(--sl-color-gray-5);
	}
	figcaption {
		position: absolute;
		left: 0.6rem;
		bottom: 0.6rem;
		font-size: 0.75rem;
		font-weight: 700;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
	}
	@media (max-width: 50rem) {
		.strip {
			grid-template-columns: 1fr;
		}
	}
</style>

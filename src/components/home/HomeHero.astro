---
// Home page hero: title and tagline from the page's front matter.
const { data } = Astro.locals.starlightRoute.entry;
const title = data.hero?.title ?? data.title;
const tagline = data.hero?.tagline;
---

<div class="hero">
	<h1 id="_top" set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
</div>

<style>
	.hero {
		padding-block: 1rem 0.5rem;
	}
	h1 {
		font-family: var(--flair-font-display);
		font-weight: 700;
		font-size: clamp(2.4rem, 4.5vw, 3.6rem);
		line-height: 1.08;
		padding-top: 0.15em;
		color: var(--sl-color-white);
	}
	.tagline {
		font-size: 1.2rem;
		color: var(--sl-color-gray-2);
		margin-top: 1rem;
	}
</style>
